ore": -2.0064}, {"title": "Cover Version", "text": "Cover Version is a compilation album released in 2014 by British musician and record producer Steven Wilson.  The album compiles the 12 songs originally released as six \"2 song\" singles.  Every release was made up of one original song and one cover song that involved new interpretations of other artist's songs in ways much different from their original versions.", "rerank_score": -2.7621}], "candidate_answer": "The Joshua Tree", "source": "gold", "generator": "gold", "difficulty": "trivial", "transformation": null, "expected_label_hint": "SUPPORTED", "corpus_size": 14}
